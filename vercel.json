{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/server.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/access-api.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/username-login.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file*.cjs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/src/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/runtime/:file*.ts",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/runtime/:file*.map",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package-lock.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/vercel.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tsconfig.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.gitignore",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.gitattributes",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.vercelignore",
      "destination": "/",
      "permanent": false
    }
  ],
  "buildCommand": "npm run build:runtime",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/conta/perfil",
      "destination": "/perfil"
    },
    {
      "source": "/conta/esqueci-senha",
      "destination": "/esqueci-senha"
    },
    {
      "source": "/conta/redefinir-senha",
      "destination": "/redefinir-senha"
    },
    {
      "source": "/administracao/acessos",
      "destination": "/acessos"
    },
    {
      "source": "/administracao/empresa",
      "destination": "/empresa"
    },
    {
      "source": "/locacao/dashboard",
      "destination": "/dashboard"
    },
    {
      "source": "/cadastros/clientes",
      "destination": "/clientes"
    },
    {
      "source": "/cadastros/carros",
      "destination": "/carros"
    },
    {
      "source": "/cadastros/fornecedores",
      "destination": "/fornecedores"
    },
    {
      "source": "/cadastros/modelos-contrato",
      "destination": "/modelos-contrato"
    },
    {
      "source": "/cadastros/certificados",
      "destination": "/certificados"
    },
    {
      "source": "/locacao/locacoes",
      "destination": "/locacoes"
    },
    {
      "source": "/locacao/painel",
      "destination": "/locacao-painel"
    },
    {
      "source": "/locacao/contratos",
      "destination": "/contratos"
    },
    {
      "source": "/locacao/contrato",
      "destination": "/contrato"
    },
    {
      "source": "/locacao/assinaturas",
      "destination": "/assinaturas"
    },
    {
      "source": "/locacao/registros",
      "destination": "/registros"
    },
    {
      "source": "/locacao/alteracoes",
      "destination": "/alteracoes"
    },
    {
      "source": "/locacao/recibos",
      "destination": "/recibos"
    },
    {
      "source": "/locacao/distratos",
      "destination": "/distratos"
    },
    {
      "source": "/locacao/documentos-modelo",
      "destination": "/documentos-modelo"
    },
    {
      "source": "/locacao/frota",
      "destination": "/frota"
    },
    {
      "source": "/locacao/substituicao",
      "destination": "/substituicao"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "outputDirectory": "."
}
