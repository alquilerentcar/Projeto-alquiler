# Copie este arquivo para .env apenas no ambiente do servidor.
# Nunca envie o arquivo .env real ao GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AUTENTIQUE_API_TOKEN=
AUTENTIQUE_SANDBOX=true
AUTENTIQUE_CLIENT_VERIFICATION=MANUAL

# Exclusivamente no servidor. Nunca coloque esta chave em arquivos HTML/JS públicos.
SUPABASE_SERVICE_ROLE_KEY=

# GroqCloud: faixa gratuita sujeita às cotas da conta.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Nome exibido no botão e no painel do assistente
AI_ASSISTANT_NAME=RECRUTA
