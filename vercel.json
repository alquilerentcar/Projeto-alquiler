    {
      "source": "/locacao/contratos",
      "destination": "/contratos.html"
    },
    {
      "source": "/locacao/contrato",
      "destination": "/contrato.html"
    },
    {
      "source": "/locacao/assinaturas",
      "destination": "/assinaturas.html"
    },
    {
      "source": "/locacao/registros",
      "destination": "/registros.html"
    },
    {
      "source": "/locacao/alteracoes",
      "destination": "/alteracoes.html"
