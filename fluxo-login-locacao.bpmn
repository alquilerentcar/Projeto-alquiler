<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Alquiler" targetNamespace="http://alquiler.local/bpmn">
  <bpmn:process id="Process_Login_Locacao" name="Acesso da empresa até a locação" isExecutable="false">
    <bpmn:startEvent id="Start" name="Abrir sistema"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Login" name="Informar CNPJ, usuário e senha"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Auth" name="Acesso válido?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Erro" name="Informar erro e tentar novamente"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Contexto" name="Carregar empresa, usuário e permissões"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Modulos" name="Mostrar módulos autorizados"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="LocacaoModulo" name="Entrar no módulo Locação"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Cadastros" name="Conferir cliente e veículo disponível"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="NovaLocacao" name="Criar locação: período, diária e caução"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Contrato" name="Revisar contrato e anexar vistoria"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="PDF" name="Gerar PDF definitivo no papel timbrado"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Assinatura" name="Assinar pela locadora e enviar ao cliente"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Assinado" name="Ambas assinaram?"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Aguardar" name="Acompanhar assinatura pendente"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Ativar" name="Confirmar locação e gerar pagamentos"><bpmn:incoming>F14</bpmn:incoming><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End" name="Locação ativa e registrada"><bpmn:incoming>F17</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Login"/><bpmn:sequenceFlow id="F2" sourceRef="Login" targetRef="Auth"/>
    <bpmn:sequenceFlow id="F3" name="Sim" sourceRef="Auth" targetRef="Contexto"/><bpmn:sequenceFlow id="F4" name="Não" sourceRef="Auth" targetRef="Erro"/><bpmn:sequenceFlow id="F5" sourceRef="Erro" targetRef="Login"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Contexto" targetRef="Modulos"/><bpmn:sequenceFlow id="F7" sourceRef="Modulos" targetRef="LocacaoModulo"/><bpmn:sequenceFlow id="F8" sourceRef="LocacaoModulo" targetRef="Cadastros"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Cadastros" targetRef="NovaLocacao"/><bpmn:sequenceFlow id="F10" sourceRef="NovaLocacao" targetRef="Contrato"/><bpmn:sequenceFlow id="F11" sourceRef="Contrato" targetRef="PDF"/>
    <bpmn:sequenceFlow id="F12" sourceRef="PDF" targetRef="Assinatura"/><bpmn:sequenceFlow id="F13" sourceRef="Assinatura" targetRef="Assinado"/><bpmn:sequenceFlow id="F14" name="Sim" sourceRef="Assinado" targetRef="Ativar"/><bpmn:sequenceFlow id="F15" name="Ainda não" sourceRef="Assinado" targetRef="Aguardar"/><bpmn:sequenceFlow id="F16" sourceRef="Aguardar" targetRef="Ativar"/><bpmn:sequenceFlow id="F17" sourceRef="Ativar" targetRef="End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram"><bpmndi:BPMNPlane id="Plane" bpmnElement="Process_Login_Locacao">
    <bpmndi:BPMNShape id="S_Start" bpmnElement="Start"><dc:Bounds x="120" y="180" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Login" bpmnElement="Login"><dc:Bounds x="210" y="158" width="130" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Auth" bpmnElement="Auth" isMarkerVisible="true"><dc:Bounds x="395" y="173" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Erro" bpmnElement="Erro"><dc:Bounds x="360" y="300" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Contexto" bpmnElement="Contexto"><dc:Bounds x="500" y="158" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Modulos" bpmnElement="Modulos"><dc:Bounds x="700" y="158" width="140" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_LocacaoModulo" bpmnElement="LocacaoModulo"><dc:Bounds x="890" y="158" width="140" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Cadastros" bpmnElement="Cadastros"><dc:Bounds x="1080" y="158" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_NovaLocacao" bpmnElement="NovaLocacao"><dc:Bounds x="1280" y="158" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Contrato" bpmnElement="Contrato"><dc:Bounds x="1490" y="158" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_PDF" bpmnElement="PDF"><dc:Bounds x="1690" y="158" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Assinatura" bpmnElement="Assinatura"><dc:Bounds x="1900" y="158" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Assinado" bpmnElement="Assinado" isMarkerVisible="true"><dc:Bounds x="2120" y="173" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Aguardar" bpmnElement="Aguardar"><dc:Bounds x="2090" y="300" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_Ativar" bpmnElement="Ativar"><dc:Bounds x="2220" y="158" width="170" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_End" bpmnElement="End"><dc:Bounds x="2440" y="180" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="E1" bpmnElement="F1"><di:waypoint x="156" y="198"/><di:waypoint x="210" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E2" bpmnElement="F2"><di:waypoint x="340" y="198"/><di:waypoint x="395" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E3" bpmnElement="F3"><di:waypoint x="445" y="198"/><di:waypoint x="500" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E4" bpmnElement="F4"><di:waypoint x="420" y="223"/><di:waypoint x="420" y="300"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E5" bpmnElement="F5"><di:waypoint x="360" y="340"/><di:waypoint x="275" y="340"/><di:waypoint x="275" y="238"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E6" bpmnElement="F6"><di:waypoint x="650" y="198"/><di:waypoint x="700" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E7" bpmnElement="F7"><di:waypoint x="840" y="198"/><di:waypoint x="890" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E8" bpmnElement="F8"><di:waypoint x="1030" y="198"/><di:waypoint x="1080" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E9" bpmnElement="F9"><di:waypoint x="1230" y="198"/><di:waypoint x="1280" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E10" bpmnElement="F10"><di:waypoint x="1440" y="198"/><di:waypoint x="1490" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E11" bpmnElement="F11"><di:waypoint x="1640" y="198"/><di:waypoint x="1690" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E12" bpmnElement="F12"><di:waypoint x="1850" y="198"/><di:waypoint x="1900" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E13" bpmnElement="F13"><di:waypoint x="2070" y="198"/><di:waypoint x="2120" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E14" bpmnElement="F14"><di:waypoint x="2170" y="198"/><di:waypoint x="2220" y="198"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E15" bpmnElement="F15"><di:waypoint x="2145" y="223"/><di:waypoint x="2145" y="300"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E16" bpmnElement="F16"><di:waypoint x="2210" y="340"/><di:waypoint x="2305" y="340"/><di:waypoint x="2305" y="238"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="E17" bpmnElement="F17"><di:waypoint x="2390" y="198"/><di:waypoint x="2440" y="198"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
